# Copy to terraform.tfvars (gitignored) and fill in. See README.md.
region            = "ap-south-2"
instance_id       = "i-0123456789abcdef0"
public_subnet_ids = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"] # two AZs of the instance's VPC
domain            = "hrzest.com"

# Route 53 zone (needed for the apex alias; also solves DNSSEC, OBS-03).
# Empty: the certificate validation CNAMEs are printed to add at Hostinger.
route53_zone_id    = ""
manage_dns_records = false # the cutover switch: true only at that runbook step

# certificate_arn = "arn:aws:acm:ap-south-2:123456789012:certificate/..."

ssh_cidrs   = [] # [] = SSM Session Manager only
decoy_ports = []

# First week after the cutover: "count", then "block".
managed_rules_action = "count"

login_rate_limit   = 300
payroll_rate_limit = 600
global_rate_limit  = 6000

geo_mode      = "off"
geo_countries = []

# existing_instance_role_name = "hrzest-ec2"
