# Files that run on Linux (containers, hosts, CI) must keep LF endings even when
# checked out on Windows (core.autocrlf=true would otherwise give them CRLF and
# a "bad interpreter: /bin/bash^M" / "\r: command not found" failure at runtime).
*.sh              text eol=lf
Containerfile     text eol=lf
*.alloy           text eol=lf
requirements*.txt text eol=lf
requirements.lock text eol=lf
# Host config files installed on the Linux server (sshd, fail2ban, nginx,
# ModSecurity), including their subdirectories, and the firewall agent.
scripts/host-hardening/** text eol=lf
scripts/firewall_agent/** text eol=lf
*.tf              text eol=lf
# GeoIP databases (tests/fixtures/geoip): binary, never line-ending converted.
*.mmdb            binary
*.service         text eol=lf
*.timer           text eol=lf
