{
  "expo": {
    "name": "HRzest.com",
    "slug": "employee-attendance",
    "sdkVersion": "57.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.magzest.attendance",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan employee QR codes for attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#28323c"
      },
      "package": "com.magzest.attendance",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-file-system",
      "expo-document-picker",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#28323c"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ea22ee12-1283-4435-8965-bcafec381509"
      }
    },
    "owner": "knithin47"
  }
}
