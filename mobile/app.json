{
  "expo": {
    "name": "HRzest",
    "slug": "employee-attendance",
    "sdkVersion": "58.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.magzest.attendance",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan employee QR codes for attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.magzest.attendance",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "HRzest uses the camera to scan attendance QR codes and take face photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-file-system",
      "expo-document-picker",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HRzest checks your location when you mark attendance, to confirm you are at your work location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HRzest lets you choose a profile or employee photo from your library.",
          "cameraPermission": "HRzest uses the camera to take a profile or employee photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HRzest can use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea22ee12-1283-4435-8965-bcafec381509"
      }
    },
    "owner": "knithin47",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ea22ee12-1283-4435-8965-bcafec381509",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "enabled": true
    }
  }
}
