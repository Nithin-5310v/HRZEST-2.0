# /etc/hrzest/firewall-agent.env -- settings for hrzest-fw-agent.service.
# install_firewall_agent.sh creates this (mode 0600) from this template.

# ── the app ──
# The agent talks to the local nginx directly and checks its certificate
# against the site's name, so the report never leaves the host.
HRZEST_FW_APP_URL=https://127.0.0.1
HRZEST_FW_APP_HOST=hrzest.com
# The same value as FIREWALL_AGENT_SECRET in the app's .env (32+ characters).
HRZEST_FW_SECRET=
# How this host appears in the SOC console's Firewall view.
# HRZEST_FW_SOURCE=host-web-1

# ── what to read (defaults shown) ──
# HRZEST_FW_KERNLOG=/var/log/ufw.log
# HRZEST_FW_FAIL2BAN_LOG=/var/log/fail2ban.log
# HRZEST_FW_MODSEC_LOG=/var/log/nginx/modsec/audit.json
# HRZEST_FW_INTERVAL=10
# HRZEST_FW_BLOCKLIST_INTERVAL=15

# ── host enforcement of the SOC ban list ──
# HRZEST_FW_HOST_ENFORCE=true
# Never block these here, whatever the ban list says (your office, VPN):
# HRZEST_FW_NEVER_BLOCK=203.0.113.0/28

# ── AWS edge (infra/terraform/edge); leave unset until it exists ──
# Needs python3-boto3 and the instance role from the edge module.
# HRZEST_FW_AWS_REGION=ap-south-2
# HRZEST_FW_WAF_SCOPE=REGIONAL
# terraform output agent_env prints the rest:
# HRZEST_FW_WAF_BLOCK_V4=hrzest-blocklist-v4/<id>
# HRZEST_FW_WAF_BLOCK_V6=hrzest-blocklist-v6/<id>
# HRZEST_FW_WAF_TRUSTED_V4=hrzest-trusted-v4/<id>
# HRZEST_FW_WAF_TRUSTED_V6=hrzest-trusted-v6/<id>
# HRZEST_FW_WAF_LOG_GROUP=aws-waf-logs-hrzest
# HRZEST_FW_FLOW_LOG_GROUP=/hrzest/vpc-flow-logs
# HRZEST_FW_WAF_ACL_NAME=hrzest-edge
# HRZEST_FW_AWS_INTERVAL=60
