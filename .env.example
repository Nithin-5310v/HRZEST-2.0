# Flask session signing key. Required in production — without it sessions
# regenerate (logging everyone out) on every container restart/redeploy.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Encrypts PII fields (Aadhar/PAN/bank account) at rest. If unset, these
# fields are stored in PLAINTEXT with no warning — set this before going live.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

APP_ENV=production

# Organisation self-registration: /create_org is open by default (any
# visitor can provision a new company/tenant) -- protected by Cloudflare
# Turnstile (TURNSTILE_SITE_KEY/TURNSTILE_SECRET_KEY below) when
# configured, not by a shared secret. See blueprints/org.py.

# Database
# Local dev: DB_HOST=localhost (or DB_HOST=db when using plain compose.yaml)
# Production: DB_HOST=<RDS endpoint from `terraform output rds_endpoint`>; DB_USER/DB_PASS
# must match db_username/db_password in terraform/terraform.tfvars
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=employee_attendance

# DB connection hardening (all optional — sensible defaults if unset)
# sslmode=prefer encrypts when the server supports it (RDS always does) but
# won't break local Postgres installs that have no SSL cert configured.
# Set to "require" or "verify-full" for a stricter production posture.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/path/to/rds-ca-bundle.pem   # only needed for verify-full
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
# Required for the seeded admin to ever log in -- role='admin' accounts
# authenticate with an emailed one-time code only, no password (see
# blueprints/auth.py's admin_login()). SMTP_* above must also be configured
# for that code to actually be delivered.
ADMIN_EMAIL=your_email@domain.com

# Mandatory MFA / 2FA gates — all four default ON (secure by default) if
# left unset. Each forces the relevant login/action to complete TOTP
# enrollment or an emailed step-up code before proceeding, with no grace
# period. Set any of them to "false" here only for a deliberate reason
# (e.g. a local dev box with no authenticator app handy) — never in
# production.
# MANDATORY_ADMIN_MFA=false          # admin/manager/hr web sessions must enroll TOTP
# MANDATORY_LOGIN_MFA=false          # emailed one-time code required at every login
# MANDATORY_PLATFORM_ADMIN_MFA=false # platform (super-admin) console login
# REQUIRE_EMAIL_2FA=false            # step-up TOTP before viewing Email Settings secrets

# Office GPS location — used for geofenced check-in. Set to your office's
# actual coordinates (e.g. from Google Maps: right-click your location).
OFFICE_LAT=0.0
OFFICE_LON=0.0

# Public base URL — used when building links in email (password reset, offer
# letters). Must NOT end with a slash. If unset, Flask falls back to the
# Host request header, which can be spoofed. Always set this in production.
# Example: APP_URL=https://attendance.yourdomain.com
# Also the site address used in /sitemap.xml, /robots.txt and the landing page's
# canonical link (blueprints/seo.py); falls back to https://www.hrzest.com.
APP_URL=

# Optional: Google Search Console ownership token (Settings > Ownership verification >
# "HTML tag" -- copy only the value of content="..."). Rendered as a
# <meta name="google-site-verification"> tag on the landing page.
GOOGLE_SITE_VERIFICATION=

# CORS — REQUIRED in production.
# Set to your frontend domain(s), comma-separated.
# If left empty in production the app will deny all cross-origin /api/* requests.
# Wildcard (*) is only acceptable for local dev; never use it in production.
# Example: ALLOWED_ORIGINS=https://attendance.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Database backups (scripts/backup_db.sh, scheduled via
# scripts/hrzest-backup.{service,timer} — see RESTORE.md).
# BACKUP_S3_BUCKET is required for the backup to leave this host; without
# it the script still runs and keeps a 30-day local copy under backups/,
# but that's not a real backup (see the script's own warning). Uses the
# AWS CLI's normal credential resolution — prefer the EC2 instance's own
# IAM role (terraform/s3_storage.tf's `backups` bucket) over static keys.
# BACKUP_S3_BUCKET=your-project-backups-123456789012
# Optional: a Healthchecks.io/Cronitor/UptimeRobot heartbeat check-in URL,
# pinged only on a successful backup — this is what surfaces a silently
# broken backup job instead of it failing quietly for months.
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-check-id

# Same heartbeat convention for wsgi.py's 7 nightly APScheduler jobs — set
# any of these to get an alert the moment that specific job stops
# completing successfully (job id -> uppercased suffix):
# HEARTBEAT_URL_DAILY_ATTENDANCE_REPORT=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_AUTO_DEBIT_SYNC_AND_BILL=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_RECONCILE_BILLING_RECORDS=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_TENANT_BILLING_DUNNING_CHECK=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_SALARY_DISBURSEMENT_PREP=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_TRIAL_EXPIRATION_CHECK=https://hc-ping.com/your-check-id
# HEARTBEAT_URL_TRIAL_ENDING_SOON_CHECK=https://hc-ping.com/your-check-id

# Malware scanning (ClamAV) for employee document/photo uploads.
# compose.yaml sets these to clamav:3310 automatically for the containerized
# stack. For local dev without Podman, point at a locally running clamd, or
# leave unset — uploads fail closed (rejected) unless APP_ENV=development,
# in which case a missing/unreachable scanner just logs a warning.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Optional shared cache (rate limiter + WAF auto-ban counters — see
# extensions.py's _init_redis_backend()). compose.yaml sets these to
# redis:6379 automatically for the containerized stack. Leave unset for
# local dev/tests, or the low-memory compose profile (which runs a single
# gunicorn worker and clears these two vars itself) — everything falls
# back to per-worker in-memory storage with no functional loss for a
# single-worker or local setup, just no longer shared across workers.
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# REQUIRE_REDIS controls what happens at boot if REDIS_HOST above ends up
# unset/unreachable (extensions.py's check_redis_requirement()). Under
# multiple gunicorn workers, no shared Redis means the rate limiter and
# the WAF auto-ban counter each enforce independently per worker --
# silently multiplying the effective ban/rate threshold by the worker
# count. Defaults (when this var is left unset): true in production
# (APP_ENV=production) -- refuses to start rather than silently running
# with a weaker security control -- and false everywhere else, so local
# dev/tests are unaffected. Set REQUIRE_REDIS=false explicitly to opt out
# for a deployment that deliberately runs a single gunicorn worker and has
# no need for a shared backend; set REQUIRE_REDIS=true to force the check
# even outside production.
# REQUIRE_REDIS=true

# WAF auto-ban tuning (utils/waf.py) -- optional, sensible defaults below if
# unset. An IP crossing WAF_BREACH_THRESHOLD WAF-blocked/rate-limited
# requests within WAF_BREACH_WINDOW_SECONDS gets banned for WAF_BAN_MINUTES.
# WAF_BREACH_WINDOW_SECONDS=600
# WAF_BREACH_THRESHOLD=5
# WAF_BAN_MINUTES=15

# Settings/companies-list/onboarding-count cache TTLs (utils/helpers.py) --
# optional, sensible defaults below if unset. Lower = settings changes are
# visible sooner; higher = fewer DB round-trips under load.
# SETTINGS_CACHE_TTL_SECONDS=60
# COMPANIES_CACHE_TTL_SECONDS=30
# ONBOARDING_CACHE_TTL_SECONDS=20

# SMTP (any provider -- STARTTLS on any port other than 465, implicit TLS on 465)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=HRzest.com
SMTP_FROM_EMAIL=your_email@domain.com

# Real-time security alerts (Slack/Discord webhook) — optional. Fires on
# ERROR-severity security events only: account lockouts, malware
# detections, injection-shaped login attempts, privilege-escalation
# attempts. Leave SECURITY_ALERT_WEBHOOK_URL unset to disable entirely —
# every call site checks it and no-ops silently if absent.
# SECURITY_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email the same ERROR-severity security alerts — optional. Comma-separated
# recipients. Sent through the app's normal SMTP settings (Email Settings page,
# or SMTP_HOST/SMTP_USER/SMTP_PASS below) via the retrying email queue, and
# throttled to one email per event type per 5 minutes. Works alongside, or
# instead of, the webhook above.
# SECURITY_ALERT_EMAIL=secops@yourcompany.com,oncall@yourcompany.com

# Employee AI chat assistant (utils/ai_assistant.py) — optional. Leave all
# three unset to disable the chat widget entirely; the endpoint then returns
# a friendly "not configured" message instead of erroring.
#
# Three backends, tried in that order — set any combination, or none:
#   1. N8N_WEBHOOK_URL — an n8n workflow's webhook node handles the query
#      (build whatever RAG/knowledge-base/ticket-creation logic you want in
#      n8n's UI, with no code changes here). Request/response contract is
#      documented in utils/ai_assistant.py's module docstring.
#   2. GEMINI_API_KEY — calls Google's Gemini API directly. Get a key at
#      https://aistudio.google.com/apikey. Used whenever n8n isn't
#      configured, or as a fallback if the n8n call fails/times out.
#   3. ANTHROPIC_API_KEY — calls Claude directly. Used whenever neither of
#      the above is configured, or as a final fallback if they fail.
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/employee-chat
# N8N_WEBHOOK_SECRET=change-me
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...

# ANTHROPIC_API_KEY above (the same one, no separate key needed) also
# powers automated company-KYC document verification (utils/
# document_verification.py) -- the vision-capable Claude call that reads a
# self-serve signup's uploaded documents, extracts GST/PAN/CIN/company
# name/address, and checks for duplicates against every other tenant.
# Fails SOFT if unset: every application just stays at
# doc_review_status='pending_review' (falls back to the existing
# platform-admin manual review queue, exactly as if this feature didn't
# exist) rather than blocking signups outright -- but since
# blueprints/auth.py's admin_login() now refuses to complete a company's
# login until doc_review_status='approved', every self-serve signup is
# effectively stuck waiting on a human reviewer with this unset. Set it
# before relying on the automated fast-path in anything but local dev.

# Razorpay — paid self-service signup (blueprints/billing.py, utils/razorpay_utils.py).
# Both required for /create_org's payment flow to work; leave unset and
# create_order() fails with a "Payments are not configured yet" message
# rather than erroring. Use test-mode keys (rzp_test_...) first — the
# Platform Admin's own "Create a new company" form stays free/unmetered and
# never touches Razorpay, so this only affects the public /create_org path.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# Same RAZORPAY_KEY_ID/SECRET above also drive seat top-ups
# (blueprints/seats.py) and monthly per-employee auto-debit
# (blueprints/auto_debit.py) -- no extra keys needed for those. Auto-debit
# additionally needs a webhook registered in the Razorpay dashboard
# (Settings -> Webhooks) pointing at https://<your-domain>/webhooks/razorpay,
# subscribed to: subscription.charged, subscription.cancelled,
# payment.failed, subscription.pending. RAZORPAY_WEBHOOK_SECRET must match
# the secret you set for that webhook in the dashboard. Without it,
# /webhooks/razorpay rejects everything (fails closed) and real recurring
# charges will never be recorded -- enrollment still works, but
# monthly_invoices stays empty until this is set. Not needed for demo mode
# (no RAZORPAY_KEY_ID/SECRET at all): auto-debit is fully exercisable
# without any of this via the built-in sandbox simulation.
# RAZORPAY_WEBHOOK_SECRET=...

# Expo push notifications (utils/push_utils.py) -- mobile leave/resignation/
# overtime approvals and admin broadcasts trigger a push alongside the
# existing in-app notification, best-effort either way. Optional: Expo's
# push API works with no token at all; setting this (an Expo access token,
# from expo.dev account settings -- unrelated to the EAS project setup
# below) just raises rate limits and attributes requests to this account.
# EXPO_ACCESS_TOKEN=...
#
# Separately, and required for this to do anything at all: mobile/app.json
# has no EAS project configured yet (no extra.eas.projectId) -- run
# `eas init` from mobile/ with an Expo account, which fills that in, before
# a real device can ever obtain a push token. The backend and DB side of
# this feature work today regardless; there's just nothing to send to yet.

# Cloudflare Turnstile — CAPTCHA challenge on /admin_login after 2 failed
# attempts against the same identifier (utils/auth.py). Optional: leave both
# unset to disable the CAPTCHA gate entirely (the 5-strikes/15-minute lockout
# still applies either way). Get keys from the Cloudflare dashboard.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SECURITY_ALERT_PLATFORM=discord
# SECURITY_ALERT_SIGNING_SECRET=

# Self-hosted log analysis dashboard (Grafana, see observability/README.md)
# -- optional. Leave unset to hide the "Log Analysis" button on the
# Platform Admin dashboard entirely. Point at the log server's own URL
# (e.g. http://<log-server-ip>:3000) -- that server's security group
# already restricts who can actually load it (trusted_admin_cidrs only),
# so this link is a convenience, not an access control.
# GRAFANA_URL=http://<log-server-ip>:3000

# Cross-app SOC dashboard (soc-dashboard/, a separate Node/Express + React
# service -- see soc-dashboard/README.md) -- optional. Leave SOC_DASHBOARD_URL
# unset to hide the "SOC Dashboard" button on the Platform Admin dashboard
# entirely. Aggregates login attempts, failed logins, and suspicious activity
# from all 4 apps (HRMS Portal, Job Portal, Gradzest Portal, Food Delivery
# App) via a shared MongoDB collection -- unrelated to this app's own
# security_events table used by /super_admin/audit-log above.
# SOC_ADMIN_TOKEN must match the ADMIN_TOKEN configured on that backend
# (soc-dashboard/backend/.env) -- it's appended to the embedded iframe's URL
# server-side so the platform admin is never shown the SOC dashboard's own
# token prompt.
# SOC_DASHBOARD_URL=http://<soc-backend-host>:4500
# SOC_ADMIN_TOKEN=<same value as soc-dashboard/backend ADMIN_TOKEN>
